# Local development configuration for ASE-ETL. Copy to .env; replace placeholders.
# Do not commit .env, credentials, tokens, or real source datasets.
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://ase_user:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost:5433/ase_etl
MINIO_ROOT_USER=REPLACE_WITH_PRIVATE_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_PRIVATE_MINIO_PASSWORD
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
SOURCE_BUCKET=ase-source
SOURCE_PREFIX=raw/
BRONZE_BUCKET=ase-bronze
SILVER_BUCKET=ase-silver
GOLD_BUCKET=ase-gold
INGEST_SOURCE=local
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
API_JWT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
